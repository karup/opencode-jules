# Jules OAuth access token
# Get your token via gcloud: gcloud auth print-access-token
# Or from https://jules.google.com/settings/api
JULES_ACCESS_TOKEN=your-access-token-here

# Optional — default GitHub source (e.g. sources/github/owner/repo)
# Run jules_list_sources to discover available sources
# JULES_SOURCE=sources/github/owner/repo
